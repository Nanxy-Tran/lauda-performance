    flexGrow: 1,
  },
  row: {
    marginBottom: 10,
  },
  rowHeader: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
    marginBottom: 4,
    gap: 8,
  },
  rowLabel: {
    flex: 1,
    color: '#8a9e94',
    fontSize: 10,
    letterSpacing: 0.6,
  },
  rowValue: {
    color: '#c4f5dc',
    fontSize: 11,
